# Signalpost provider configuration.
# The batch runner can run without this file. Copy to .env.local and keep real
# keys there; .env.local is ignored by Git.

# Submitted search path: native OpenAI + Firecrawl.
SIGNALPOST_MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://api.openai.com/v1
FIRECRAWL_API_KEY=

# Positive allowances explicitly enable provider calls. Set the model cost to
# your conservative per-call USD reservation; OpenAI/OpenRouter pricing is not
# guessed by the runner.
MAX_LLM_CALLS=100
MAX_LLM_TOKENS=250000
MAX_SEARCH_CALLS=100
MAX_COST_USD=10
SIGNALPOST_MODEL_COST_PER_CALL_USD=
FIRECRAWL_SEARCH_COST_PER_CALL_USD=0

# Optional runtime limits. These defaults are safe for the official contract.
RUN_DEADLINE_SECONDS=2700
MAX_OUTBOUND_REQUESTS=2000
SIGNALPOST_DAILY_COST_CAP_USD=10
SIGNALPOST_DAILY_COST_LEDGER=~/.cache/signalpost/daily-cost.json

# To use the cheaper Groq alternative, replace the model provider/key block:
# SIGNALPOST_MODEL_PROVIDER=groq
# GROQ_API_KEY=your-groq-key
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# For Groq GPT-OSS 120B, the runner uses the published price automatically.

# To use OpenRouter instead of native OpenAI:
# SIGNALPOST_MODEL_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-openrouter-key
# OPENROUTER_MODEL=openai/gpt-5.6-sol
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://github.com/nomadrai/signalpost
# OPENROUTER_APP_TITLE=Signalpost
