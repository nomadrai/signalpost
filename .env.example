# Optional runtime configuration. Keep real credentials outside this repository.
RUN_DEADLINE_SECONDS=2700
RUN_DEADLINE_SAFETY_SECONDS=5
COMPANY_TIMEOUT_SECONDS=45
MAX_OUTBOUND_REQUESTS=2000
SIGNALPOST_USER_AGENT=
MAX_LLM_CALLS=0
MAX_LLM_TOKENS=0
MAX_SEARCH_CALLS=0
MAX_COST_USD=0
BRAVE_SEARCH_API_KEY=

# Optional OpenAI-compatible evidence assistant. The default batch never calls
# a model; enable explicitly with --model-assist and set positive LLM allowances.
SIGNALPOST_MODEL_API_KEY=
SIGNALPOST_MODEL_ENDPOINT=https://api.openai.com/v1/chat/completions
SIGNALPOST_MODEL=openai/gpt-oss-120b
SIGNALPOST_MODEL_TIMEOUT_SECONDS=30
SIGNALPOST_MODEL_MAX_INPUT_CHARS=18000
SIGNALPOST_MODEL_MAX_OUTPUT_TOKENS=1200
SIGNALPOST_MODEL_COST_PER_CALL_USD=0
