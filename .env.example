# Optional runtime configuration. Keep real credentials outside this repository.
RUN_DEADLINE_SECONDS=2700
RUN_DEADLINE_SAFETY_SECONDS=5
COMPANY_TIMEOUT_SECONDS=45
MAX_OUTBOUND_REQUESTS=2000
SIGNALPOST_USER_AGENT=
MAX_LLM_CALLS=0
MAX_LLM_TOKENS=0
MAX_SEARCH_CALLS=0
MAX_COST_USD=0
FIRECRAWL_API_KEY=
FIRECRAWL_ENDPOINT=https://api.firecrawl.dev/v2/search
SIGNALPOST_DAILY_COST_CAP_USD=10
SIGNALPOST_DAILY_COST_LEDGER=~/.cache/signalpost/daily-cost.json
# Optional local per-key cap; Groq's actual quotas are organization-wide.
SIGNALPOST_MODEL_REQUESTS_PER_KEY_PER_DAY=0
# Firecrawl Search costs 2 credits per 10 results. The free plan has 1,000
# monthly credits; zero here declares that the selected allocation remains free.
FIRECRAWL_SEARCH_COST_PER_CALL_USD=0

# Optional OpenAI-compatible evidence assistant. The default batch never calls
# a model; enable explicitly with --model-assist and set positive LLM allowances.
SIGNALPOST_MODEL_API_KEY=
SIGNALPOST_MODEL_API_KEYS=
GROQ_API_KEY=
GROQ_API_KEYS=
SIGNALPOST_MODEL_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
GROQ_BASE_URL=https://api.groq.com/openai/v1
SIGNALPOST_MODEL=openai/gpt-oss-120b
SIGNALPOST_MODEL_TIMEOUT_SECONDS=30
SIGNALPOST_MODEL_MAX_INPUT_CHARS=18000
SIGNALPOST_MODEL_MAX_OUTPUT_TOKENS=1200
# Groq GPT-OSS 120B uses the published price when this is zero.
# Other provider/model pairs require an explicit upper bound.
SIGNALPOST_MODEL_COST_PER_CALL_USD=0
